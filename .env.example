# Copy to .env using ./scripts/bootstrap.sh. Never commit the generated .env.
TRUSTSOC_ENV=development
TRUSTSOC_DOMAIN=localhost
TRUSTSOC_LOG_LEVEL=INFO
TRUSTSOC_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080
TRUSTSOC_JWT_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
TRUSTSOC_ENCRYPTION_KEY=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
TRUSTSOC_ACCESS_TOKEN_MINUTES=15
TRUSTSOC_REFRESH_TOKEN_DAYS=7
TRUSTSOC_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TRUSTSOC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
TRUSTSOC_BOOTSTRAP_ORG_NAME=TRUST-SOC Lab

POSTGRES_DB=trustsoc
POSTGRES_USER=trustsoc
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
TRUSTSOC_DATABASE_URL=postgresql+asyncpg://trustsoc:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/trustsoc
TRUSTSOC_REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_API_BASE_URL=/api
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
INTERNAL_API_BASE_URL=http://api:8000

# Wazuh API (optional). For Docker Desktop, host.docker.internal reaches the host.
TRUSTSOC_WAZUH_ENABLED=false
TRUSTSOC_WAZUH_URL=https://host.docker.internal:55000
TRUSTSOC_WAZUH_USERNAME=wazuh-wui
TRUSTSOC_WAZUH_PASSWORD=CHANGE_ME_WAZUH_PASSWORD
TRUSTSOC_WAZUH_VERIFY_TLS=false

# SMTP / alerting (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Wazuh real-time synchronization
TRUSTSOC_WAZUH_INDEXER_URL=https://host.docker.internal:9200
TRUSTSOC_WAZUH_INDEXER_USERNAME=admin
TRUSTSOC_WAZUH_INDEXER_PASSWORD=change-me
TRUSTSOC_WAZUH_INDEXER_VERIFY_TLS=false
TRUSTSOC_WAZUH_ALERT_INDEX=wazuh-alerts-*
TRUSTSOC_WAZUH_SYNC_ENABLED=true
TRUSTSOC_WAZUH_SYNC_INTERVAL_SECONDS=60
TRUSTSOC_WAZUH_ALERT_LOOKBACK_HOURS=24
TRUSTSOC_WAZUH_ALERT_BATCH_SIZE=500

# Alert correlation, noise reduction, and incident response
TRUSTSOC_ALERT_AGGREGATION_WINDOW_MINUTES=15
TRUSTSOC_AUTO_INCIDENT_ENABLED=true
TRUSTSOC_AUTO_INCIDENT_MIN_RULE_LEVEL=12
TRUSTSOC_AUTO_INCIDENT_REPETITION_THRESHOLD=10
TRUSTSOC_INCIDENT_SLA_CRITICAL_HOURS=1
TRUSTSOC_INCIDENT_SLA_HIGH_HOURS=4
TRUSTSOC_INCIDENT_SLA_MEDIUM_HOURS=24
TRUSTSOC_INCIDENT_SLA_LOW_HOURS=72

# Deployed honeypot SOC connector through the local SSH tunnel
TRUSTSOC_HONEYPOT_ENABLED=false
TRUSTSOC_HONEYPOT_API_URL=http://host.docker.internal:18000
TRUSTSOC_HONEYPOT_GRAFANA_URL=https://52.237.90.251/grafana/
TRUSTSOC_HONEYPOT_VERIFY_TLS=false
TRUSTSOC_HONEYPOT_SYNC_ENABLED=true
TRUSTSOC_HONEYPOT_SYNC_INTERVAL_SECONDS=60
TRUSTSOC_HONEYPOT_EVENT_BATCH_SIZE=250
TRUSTSOC_HONEYPOT_ALERT_BATCH_SIZE=250
TRUSTSOC_HONEYPOT_ATTACKER_BATCH_SIZE=100
